# AWS / S3 (Factored Datathon): used by data-pipeline ingestion, not queried
# directly by the live triage API. Fill locally; never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=factored-datathon-2026-s3-
S3_PREFIX=

# S3 key prefix containing daily transaction CSV partitions.
# Blank uses the observed bucket layout: data/transactions/year=.../month=.../day=...
S3_TRANSACTIONS_PREFIX=data/transactions/

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Google AI Studio (Gemini entity extraction)
GEMINI_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_API_KEY_HERE
GEMINI_MODEL=gemini-flash-latest

# Optional databases (deploy targets)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
